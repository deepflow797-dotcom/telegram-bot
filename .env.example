# ---------------------------------------------------------------------------
# Rental management Telegram bot — environment variables
# Copy to .env (never commit .env) and fill in real values.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (looks like 123456789:AA...).
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Your personal Telegram user id (send /id to the bot, or ask @userinfobot).
TELEGRAM_OWNER_ID=123456789

# Random secret that Telegram must send with every webhook request.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32-chars

# PostgreSQL connection string (Supabase → Settings → Database → Connection string).
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Secret protecting /api/cron/daily-report and /api/admin/* endpoints.
# Vercel Cron sends it automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=replace-with-random-32-chars

# IANA timezone used for report dates and rental cycles.
APP_TIMEZONE=Africa/Nouakchott

# 3-letter ISO currency code used as the default for new tenants.
DEFAULT_CURRENCY=MRU

# Public base URL of the deployment. With AUTO_SETUP=true the webhook is
# registered automatically on the first request.
WEBHOOK_URL=https://your-project.vercel.app/api/telegram/webhook

# Zero-touch setup: on the first request apply missing migrations and register
# WEBHOOK_URL with Telegram (idempotent, guarded by the app_settings table).
AUTO_SETUP=true

# Optional: log level (INFO, DEBUG, WARNING, ERROR).
LOG_LEVEL=INFO

# Optional: Supabase project metadata (not required by the app itself).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
